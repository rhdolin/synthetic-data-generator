# Copy to .env and fill in the <placeholders>. .env is git-ignored; never commit credentials.
# Values below are the servers used by FHIR/genomics-operations and the MTB app.

# cBioPortal source
CBIOPORTAL_API_URL=https://www.cbioportal.org/api

# Clinical FHIR server (mCODE bundles). Public HAPI test server, as used by the MTB app
# (genomics-apps/mtb-app/src/services/clinicalService.ts).
FHIR_SERVER_URL=https://hapi.fhir.org/baseR4

# Genomics Operations server (genomics-apps/mtb-app/src/services/variantService.ts)
GENOMICS_OPERATIONS_URL=https://fhir-gen-ops.herokuapp.com

# MongoDB Atlas cluster behind the Operations server (app/common.py).
# Loading needs a user with write access; the Operations server itself uses the read-only user.
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.8ianr.mongodb.net
MONGO_DB=FHIRGenomicsData
# Gene/exon coordinates and other utility collections (read-only is enough)
MONGO_UTILITIES_DB=UtilitiesData

# Local paths
HARVEST_DIR=data/harvest
OUTPUT_DIR=data/output
